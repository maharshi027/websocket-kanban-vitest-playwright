{
  "name": "websocket-kanban-board",
  "version": "1.0.0",
  "description": "WebSocket-powered Kanban Board with React and Node.js",
  "scripts": {
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "start:backend": "cd backend && npm start",
    "build:frontend": "cd frontend && npm run build",
    "test:frontend": "cd frontend && npm test",
    "test:e2e": "cd frontend && npm run test:e2e",
    "playwright:install": "cd frontend && npx playwright install"
  },
  "keywords": ["kanban", "websocket", "react", "socket.io", "vitest", "playwright"],
  "author": "",
  "license": "MIT"
}
